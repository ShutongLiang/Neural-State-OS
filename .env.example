# Optional external experimental-probe locations. Core Direct-44 does not need them.
NEURAL_STATE_OS_EXPERIMENT_ROOT=/absolute/path/to/experimental-probes
NEURAL_STATE_OS_PERSONA_BANK=/absolute/path/to/persona_reader.npz

# Optional local Apple-silicon runtime settings.
NEURAL_STATE_OS_PYTHON=/absolute/path/to/python3
NEURAL_STATE_OS_12B_MODEL=/absolute/path/to/gemma-4-12B-it-4bit-mlx
NEURAL_STATE_OS_VENV=/absolute/path/to/neural-state-os/venv-mlx
NEURAL_STATE_OS_PIP_INDEX_URL=https://pypi.org/simple
NEURAL_STATE_OS_HOST=127.0.0.1
NEURAL_STATE_OS_PORT=8768
NEURAL_STATE_OS_MAX_TOKENS=512
NEURAL_STATE_OS_THINKING_MAX_TOKENS=1024
NEURAL_STATE_OS_MLX_MEMORY_LIMIT_GB=0
NEURAL_STATE_OS_MLX_CACHE_LIMIT_MB=0
